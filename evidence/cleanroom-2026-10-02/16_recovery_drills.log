-- 1. Time Travel READ: the ledger as it was before / after the three commits (retention 1 day)
   offset -1500: 000707 (02000): Time travel data is not available for table DECISION_LEDGER. The requested time is either beyond the all
>> SELECT -900 AS OFFSET_SECONDS, COUNT(*) FROM FIU_COPILOT_CR.AML.DECISION_LEDGER AT (OFFSET => -900)
   [(-900, 0)]
>> SELECT -1 AS OFFSET_SECONDS, COUNT(*) FROM FIU_COPILOT_CR.AML.DECISION_LEDGER AT (OFFSET => -1)
   [(-1, 3)]

-- 2. Restore rehearsal: clone the ledger AS OF a timestamp into a SCRATCH table (creates one new table; changes nothing existing)
>> CREATE TABLE FIU_COPILOT_CR.AML.DECISION_LEDGER_RESTORE_DRILL CLONE FIU_COPILOT_CR.AML.DECISION_LEDGER AT (TIMESTAMP => '2026-10-01 21:20:56.872 -0700'::TIMESTAMP_LTZ)
   [('Table DECISION_LEDGER_RESTORE_DRILL successfully created.',)]
>> SELECT COUNT(*), HASH_AGG(*) FROM FIU_COPILOT_CR.AML.DECISION_LEDGER_RESTORE_DRILL
   [(3, 2724711439665836922)]
   live (3, 2724711439665836922)  clone (3, 2724711439665836922)  IDENTICAL: True
>> SELECT COUNT(*) FROM FIU_COPILOT_CR.AML.DECISION_LEDGER_RESTORE_DRILL r WHERE r.DECISION_ID NOT IN (SELECT DECISION_ID FROM FIU_COPILOT_CR.AML.DECISION_LEDGER)
   [(0,)]
   rows in the clone missing from the live ledger (what an INSERT-only restore would add): 0

