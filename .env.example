# Copy to .env and fill in. .env is gitignored — never commit it. Live tests SKIP only when the
# three REQUIRED items below are absent; if they are present and the connection fails, the test FAILS
# with a one-line, secret-free explanation (skills/connection.py).

# ── REQUIRED ────────────────────────────────────────────────────────────────
SNOWFLAKE_ACCOUNT=<org>-<account>          # e.g. MYORG-MYACCOUNT  (Snowsight → account menu → "Copy account identifier")
SNOWFLAKE_USER=<your-username>
# plus ONE credential:
SNOWFLAKE_PASSWORD=<your-password>
# SNOWFLAKE_PRIVATE_KEY_PATH=/path/to/rsa_key.p8          # key-pair auth (needed if your account enforces MFA)
# SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=<passphrase-if-any>
# SNOWFLAKE_PAT=<programmatic-access-token>               # alternative to password

# ── OPTIONAL (defaults shown) ───────────────────────────────────────────────
SNOWFLAKE_WAREHOUSE=FIU_WH
SNOWFLAKE_DATABASE=FIU_COPILOT
SNOWFLAKE_SCHEMA=AML
# Role for local runs / scripts. Leave unset to use your user's default role. After
# `python3 scripts/deploy_snowflake.py --apply` prefer the least-privilege app role for the app:
# SNOWFLAKE_ROLE=FIU_APP_ROLE
# Role the RBAC live tests connect as (default FIU_APP_ROLE):
# SNOWFLAKE_APP_ROLE=FIU_APP_ROLE

# ── Cortex model override (defaults verified live in AWS_AP_SOUTHEAST_7, 2026-09-30) ──
# FIU_CORTEX_MODEL=llama3.3-70b
# FIU_CORTEX_MODEL_FALLBACK=llama3.1-8b
# A model that is not in skills/core.py APPROVED_MODELS is REFUSED (nothing is sent; the officer decides without AI). Extending that list is a reviewed code change.

# Cortex Analyst from a local run needs NO extra token: the connector session token is used automatically.
# (SNOWFLAKE_PAT is only a fallback when no connector session exists.)

# Set to 1 to KEEP the ledger rows written by tests/test_live_e2e.py (default: rolled back).
# LIVE_SMOKE_COMMIT=0
